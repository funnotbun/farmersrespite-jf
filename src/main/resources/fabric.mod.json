{
  "schemaVersion": 1,

  "id": "farmersrespite",
  "version": "${version}",
  "license": "MIT",

  "name": "Farmer's Respite",
  "icon": "assets/farmersrespite/icon.png",
  "description": "An addon created by Umpaz, HoboJoe, and SoyTutta for the Farmer's Delight mod by vectorwing. Attempts to add tea and ways to brew it, as well as some other foods!",

  "authors": [
    "StevenPlayzz",
    "JustinPlayzz",
    "Umpaz",
    "HoboJoe",
    "SoyTutta"
  ],

  "contact": {
    "homepage": "",
    "sources": "",
    "issues": ""
  },

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.chefsdelights.farmersrespite.core.FarmersRespite"
    ],
    "client": [
      "com.chefsdelights.farmersrespite.client.FRClientSetup"
    ],
    "jei_mod_plugin": [
      "com.chefsdelights.farmersrespite.integration.jei.FarmersRespiteJEIPlugin"
    ]
  },
  "mixins": [
    "farmersrespite.mixins.json"
  ],
  "accessWidener": "farmersrespite.accesswidener",

  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.2 <=26.2",
    "java": ">=25",
    "fabric-api": ">=0.155.0",
    "farmersdelight": ">=26.2-3.6.6",
    "cloth-config": ">=26.2.155"
  },

  "custom": {
    "modmenu": {
      "badges": [],
      "links": {
        "modmenu.discord": "https://discord.gg/eRdBB86Nr7"
      }
    }
  }
}
